DATABASE_URL="mysql+aiomysql://root@localhost:3306/arecanut_grade_nut"

JWT_SECRET=your_jwt_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=102400
