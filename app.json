{
  "expo": {
    "name": "ArecaNutMobile",
    "slug": "ArecaNutMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Logo3_square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aldio.arecanut"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Logo3_square.png",
        "backgroundColor": "#572B18"
      },
      "package": "com.aldio.arecanut",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "./withGradleWrapper.js",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/Logo3.png",
          "backgroundColor": "#572B18",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "15d99907-1e37-40c9-8b21-816460d632f9"
      }
    }
  }
}
